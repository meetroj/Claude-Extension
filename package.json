{
  "name": "oi",
  "displayName": "Status for Claude Code",
  "description": "See your Claude Code usage at a glance: what the session is doing, today's tokens, and your plan limits, right in the status bar.",
  "version": "0.0.4",
  "publisher": "meetroj",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oi.start",
        "title": "Claude Status: Start (roam the code)"
      },
      {
        "command": "oi.lap",
        "title": "Claude Status: Walk in the status bar"
      },
      {
        "command": "oi.shout",
        "title": "Claude Status: Shout (take over the title bar)"
      },
      {
        "command": "oi.stop",
        "title": "Claude Status: Stop"
      },
      {
        "command": "oi.ack",
        "title": "Claude Status: Acknowledge"
      },
      {
        "command": "npmGuard.scan",
        "title": "npm-guard: Scan this folder"
      },
      {
        "command": "npmGuard.fix",
        "title": "npm-guard: Fix what it safely can (shows the exact changes, asks twice, never deletes a file)"
      },
      {
        "command": "npmGuard.restore",
        "title": "npm-guard: Restore the last backup (asks first)"
      },
      {
        "command": "npmGuard.protectRepo",
        "title": "npm-guard: Protect this repository (its own git hooks, e.g. husky)"
      },
      {
        "command": "npmGuard.unprotectRepo",
        "title": "npm-guard: Unprotect this repository (remove exactly that)"
      },
      {
        "command": "npmGuard.install",
        "title": "npm-guard: Turn on protection (git hooks and Claude Code)"
      },
      {
        "command": "npmGuard.uninstall",
        "title": "npm-guard: Turn off protection"
      },
      {
        "command": "npmGuard.status",
        "title": "npm-guard: Show status"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "oi",
          "title": "Claude Status",
          "icon": "media/claude.svg"
        }
      ]
    },
    "views": {
      "oi": [
        {
          "type": "webview",
          "id": "oi.walk",
          "name": "Claude Status"
        }
      ],
      "explorer": [
        {
          "id": "oi.usage",
          "name": "Claude Usage"
        }
      ]
    },
    "configuration": [
      {
        "title": "Claude Status",
        "properties": {
          "oi.autoPet": {
            "type": "boolean",
            "default": false,
            "description": "Start the pet when Claude starts working and have it shout your name when Claude finishes. Click the pet to stop it."
          },
          "oi.name": {
            "type": "string",
            "default": "meet",
            "description": "The name the pet shouts."
          }
        }
      },
      {
        "title": "npm-guard",
        "properties": {
          "npmGuard.scanOnOpen": {
            "type": "boolean",
            "default": true,
            "description": "Scan the folder for the malware loader when it opens. Scanning reads file contents without executing or modifying project code."
          }
        }
      }
    ],
    "icons": {
      "oi-claude": {
        "description": "Claude",
        "default": {
          "fontPath": "media/claude.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "test": "node src/pet/name-stretch.js && npm run compile && node src/status/usage-check.js && node src/npm-guard/guard-check.js && node src/npm-guard/guard-ui-check.js",
    "build:cli": "npm run compile && node cli/build.js",
    "test:cli": "npm run build:cli && node cli/cli-check.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "usage",
    "tokens",
    "status bar",
    "ai",
    "security",
    "malware",
    "git hooks"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Scanning reads file contents without executing or modifying project code, so it runs in a folder you have not trusted yet, which is when it matters most. Fixing and protection only start when you confirm."
    }
  }
}
